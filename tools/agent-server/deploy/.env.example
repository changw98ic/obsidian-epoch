# Production public origin. Replace this with the exact HTTPS origin exposed by
# DNS/TLS/reverse proxy. Production install smoke and generated host configs must
# not use localhost, 127.0.0.1 or an internal Docker hostname as serverBase.
AGENT_IMAGE_REGISTRY=
AGENT_IMAGE_VERSION=0.1.0-alpha
AGENT_IMAGE_REVISION=
AGENT_IMAGE_SOURCE=
# Set from the release commit: git show -s --format=%ct <release-commit>
SOURCE_DATE_EPOCH=
# Set after pushing the image, including the sha256: prefix. Release rehearsal
# records this immutable registry digest alongside the downloaded package digest.
AGENT_RELEASE_IMAGE_DIGEST=
AGENT_RELEASE_IMAGE_REFERENCE=
AGENT_PUBLIC_SERVER_BASE=https://your-domain.example
AGENT_PUBLIC_HOST=your-domain.example
AGENT_SERVER_ALLOWED_ORIGINS=https://your-domain.example
AGENT_SERVER_MAX_BODY_BYTES=1000000
# Application-container runtime limits. Give Docker a grace period longer than
# the server's millisecond drain timeout so the process owns the first deadline.
AGENT_SERVER_CPU_LIMIT=1.0
AGENT_SERVER_MEMORY_LIMIT=1g
AGENT_SERVER_PIDS_LIMIT=256
AGENT_SERVER_TMPFS_SIZE=64m
AGENT_SERVER_SHUTDOWN_TIMEOUT_MS=10000
AGENT_SERVER_STOP_GRACE_PERIOD=15s
AGENT_CADDY_CPU_LIMIT=0.5
AGENT_CADDY_MEMORY_LIMIT=256m
AGENT_CADDY_PIDS_LIMIT=128
AGENT_CADDY_TMPFS_SIZE=32m
AGENT_SERVER_STORE=sqlite
AGENT_SERVER_DATA_DIR=/data
AGENT_SERVER_SQLITE_PATH=/data/agent-world.sqlite
AGENT_SERVER_SQLITE_MIGRATE_JSONL=0
AGENT_SERVER_BACKUP_DIR=/backups
AGENT_SERVER_BACKUP_KEEP_LAST=14
# Generate a second, independent Ed25519 keypair for recovery backups. Keep the
# private key only on backup workers; restore workers receive a pinned public
# key or version-1 public-key ring. Never reuse AGENT_PACKAGE_SIGNING_PRIVATE_KEY_PEM.
AGENT_SERVER_BACKUP_SIGNING_PRIVATE_KEY_FILE=/etc/obsidian-epoch/backup-signing-private-key.pem
AGENT_SERVER_BACKUP_VERIFICATION_PUBLIC_KEY_FILE=/etc/obsidian-epoch/backup-verification-public-keys.json
AGENT_SERVER_BACKUP_SIGNATURE_REQUIRED=1
# Copy this checkpoint from an out-of-band inventory or change record, never
# derive it from the backup directory being restored.
AGENT_SERVER_BACKUP_TRUSTED_CHECKPOINT_FILE=/etc/obsidian-epoch/backup-trusted-checkpoint.json
AGENT_SERVER_BACKUP_REPLAY_PROTECTION_REQUIRED=1
# The production Docker image keeps the large 00_总览/assets/media tree outside
# the image. Upload that directory to CDN/object storage or mount and publish it
# separately, then point the browser console at its public HTTPS base URL.
AGENT_EPOCH_CONSOLE_MEDIA_BASE_URL=https://cdn.your-domain.example/obsidian-epoch/assets/media
AGENT_SERVER_OPERATOR_KEY_FILE=/etc/obsidian-epoch/operator-key.txt
AGENT_SERVER_MCP_BEARER_TOKEN_FILE=/etc/obsidian-epoch/mcp-bearer-token.txt
AGENT_SERVER_MCP_PLAYER_TOKEN_JSONL_PATH=/data/player-mcp-access-tokens.jsonl
AGENT_SERVER_MCP_PLAYER_TOKEN_TTL_SECONDS=43200
AGENT_SERVER_REGISTRATION_SECRET_FILE=/etc/obsidian-epoch/registration-secret.txt
# Independent HMAC key used only to pseudonymize registration actor signals.
# With the bundled Caddy reverse proxy there is one trusted proxy hop.
AGENT_SERVER_REGISTRATION_ACTOR_HASH_SECRET_FILE=/etc/obsidian-epoch/registration-actor-hash-secret.txt
AGENT_SERVER_REGISTRATION_TRUST_PROXY_HOPS=1
AGENT_SERVER_PUBLIC_REGISTRATION_MODE=enforce
AGENT_SERVER_REGISTRATION_WINDOW_SECONDS=86400
AGENT_SERVER_REGISTRATION_MAX_ACTIONS=8
AGENT_SERVER_REGISTRATION_COOLDOWN_SECONDS=30
AGENT_SERVER_REGISTRATION_DEVICE_CHALLENGE_TTL_SECONDS=86400
# Optional comma-separated launch invites in a mode-0600 file. Raw values are
# hashed at startup and never written to the player token/registration ledger.
AGENT_SERVER_REGISTRATION_INVITES_FILE=/etc/obsidian-epoch/registration-invites.txt
# Required for production releases. Generate with:
# npm run agent:generate-signing-key -- --json
# Store privateKeyPem here through your secret manager. Leaving this blank uses
# a process-ephemeral local alpha key, which is only acceptable for local smoke
# and is not a production trust root.
AGENT_PACKAGE_SIGNING_PRIVATE_KEY_PEM_FILE=/etc/obsidian-epoch/package-signing-private-key.pem
# Production remote smoke must target the public HTTPS origin and require
# operator signing. Use the generated releaseKeyId as the expected key id.
AGENT_INSTALL_SMOKE_REQUIRE_OPERATOR_SIGNING=1
AGENT_INSTALL_SMOKE_EXPECTED_RELEASE_KEY_ID=
AGENT_SERVER_MAINTENANCE_ENABLED=1
AGENT_SERVER_MAINTENANCE_INTERVAL_MS=900000
AGENT_SERVER_MAINTENANCE_NPC_REGION_ID=
AGENT_SERVER_MAINTENANCE_NPC_LIMIT=5
AGENT_SERVER_MAINTENANCE_MARKET_MAX_AGE_SECONDS=86400
AGENT_SERVER_MAINTENANCE_MARKET_LIMIT=50
AGENT_SERVER_MAINTENANCE_RESOURCE_NODE_REGION_IDS=
AGENT_SERVER_MAINTENANCE_RESOURCE_NODE_LIMIT=0
AGENT_SERVER_MAINTENANCE_RESOURCE_NODE_SETTLEMENT_LIMIT=0
AGENT_SERVER_MAINTENANCE_ANOMALY_REGION_IDS=
AGENT_SERVER_MAINTENANCE_ANOMALY_LIMIT=0
AGENT_SERVER_MAINTENANCE_ANOMALY_TEMPLATE_KEY=
AGENT_SERVER_MAINTENANCE_SEASON_REGION_IDS=
AGENT_SERVER_MAINTENANCE_SEASON_LIMIT=0
AGENT_SERVER_MAINTENANCE_SEASON_KEY=
AGENT_SERVER_MAINTENANCE_SEASON_SETTLEMENT_LIMIT=0
AGENT_SERVER_MAINTENANCE_PARTY_RUN_SETTLEMENT_LIMIT=0
AGENT_SERVER_MAINTENANCE_REGION_CONTROL_DECAY_LIMIT=0
AGENT_SERVER_MAINTENANCE_REGION_CONTROL_DECAY_AMOUNT=1
AGENT_SERVER_MAINTENANCE_REGION_CONTROL_DECAY_MIN_AGE_SECONDS=604800
AGENT_SERVER_MAINTENANCE_SERVER_HOSTED_JOB_LIMIT=0
AGENT_SERVER_MAINTENANCE_RUN_ON_START=1
# Mode-0600 JSON array of runner configs. Use [] when runners are disabled.
AGENT_SERVER_ATTESTED_RUNNERS_FILE=/etc/obsidian-epoch/attested-runners.json
