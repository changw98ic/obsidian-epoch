{
  "name": "obsidian-epoch-graph-react",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "test": "npm run agent:test && npm run batch:test && npm run agent:ui-test",
    "typecheck": "npm run check:repository-import && npm run check:asset-manifest && npm run check:no-js && npm run check:no-explicit-any && npm run check:strict-serial-validation && npm run typecheck:web && npm run typecheck:agent",
    "check:repository-import": "tsx scripts/check-repository-import.ts",
    "check:asset-manifest": "tsx scripts/object-storage-manifest.ts --check",
    "asset:manifest:write": "tsx scripts/object-storage-manifest.ts --write",
    "asset:manifest:verify-local": "tsx scripts/object-storage-manifest.ts --verify-local",
    "asset:manifest:verify-remote": "tsx scripts/object-storage-manifest.ts --verify-remote",
    "check:no-js": "tsx scripts/check-no-js-source.ts",
    "check:no-explicit-any": "tsx scripts/check-no-explicit-any-source.ts",
    "check:strict-serial-validation": "tsx scripts/check-strict-serial-validation.ts",
    "typecheck:web": "tsc --noEmit",
    "typecheck:agent": "node --stack_size=8192 ./node_modules/typescript/bin/tsc -p tsconfig.agent-server.json",
    "build": "npm run build:export",
    "build:export": "python3 ../build_world_map_data.py && vite build && tsx scripts/copy-data.ts",
    "build:container": "vite build && tsx scripts/copy-data.ts --skip-media",
    "preview": "npm run build:export && python3 -m http.server 4173 --bind 127.0.0.1 --directory ../../00_总览",
    "agent:server": "node --import tsx ../agent-server/server.ts",
    "agent:mcp": "node --import tsx ../agent-server/mcp.ts",
    "agent:journey-soak": "node --import tsx ../agent-server/journey-soak.ts",
    "agent:world-content:compile": "node --import tsx ../agent-server/compile-world-content.ts",
    "agent:world-content:check": "node --import tsx ../agent-server/compile-world-content.ts --check",
    "agent:generate-boss-assets": "node --import tsx ../agent-server/generate-boss-assets.ts",
    "agent:generate-location-assets": "node --import tsx ../agent-server/generate-location-assets.ts",
    "agent:generate-npc-assets": "node --import tsx ../agent-server/generate-npc-assets.ts",
    "agent:generate-item-assets": "node --import tsx ../agent-server/generate-item-assets.ts",
    "agent:generate-faction-assets": "node --import tsx ../agent-server/generate-faction-assets.ts",
    "agent:generate-resource-assets": "node --import tsx ../agent-server/generate-resource-assets.ts",
    "agent:generate-activity-assets": "node --import tsx ../agent-server/generate-activity-assets.ts",
    "agent:generate-relationship-assets": "node --import tsx ../agent-server/generate-relationship-assets.ts",
    "agent:generate-world-surface-assets": "node --import tsx ../agent-server/generate-world-surface-assets.ts",
    "agent:generate-world-scene-assets": "node --import tsx ../agent-server/generate-world-scene-assets.ts",
    "agent:generate-scene-variant-assets": "node --import tsx ../agent-server/generate-scene-variant-assets.ts",
    "agent:generate-page-scene-assets": "node --import tsx ../agent-server/generate-page-scene-assets.ts",
    "agent:generate-campaign-assets": "node --import tsx ../agent-server/generate-campaign-assets.ts",
    "agent:generate-ambience-assets": "node --import tsx ../agent-server/generate-ambience-assets.ts",
    "agent:generate-event-state-assets": "node --import tsx ../agent-server/generate-event-state-assets.ts",
    "agent:generate-signing-key": "node --import tsx ../agent-server/generate-signing-key.ts",
    "agent:sign-attestation": "node --import tsx ../agent-server/sign-attestation.ts",
    "agent:verify-attested-receipt": "node --import tsx ../agent-server/verify-attested-receipt.ts",
    "agent:install-smoke": "node --import tsx ../agent-server/install-smoke.ts",
    "agent:sync-install-manifests": "node --import tsx ../agent-server/sync-install-manifests.ts",
    "agent:release-rehearsal": "node --import tsx ../agent-server/release-rehearsal.ts",
    "check:release-source": "node --import tsx ../agent-server/verify-release-source.ts",
    "agent:migrate:sqlite": "node --import tsx ../agent-server/migrate-sqlite.ts",
    "agent:recovery-drill": "node --import tsx ../agent-server/recovery-drill.ts",
    "agent:backup": "node --import tsx ../agent-server/backup.ts",
    "agent:restore-backup": "node --import tsx ../agent-server/restore-backup.ts",
    "agent:container-lifecycle-gate": "node --import tsx ../agent-server/container-lifecycle-gate.ts",
    "agent:caddy-container-gate": "node --import tsx ../agent-server/caddy-container-gate.ts",
    "agent:visual-qa": "node --import tsx scripts/agent-console-visual-qa.ts",
    "agent:test": "node --import tsx --test ../agent-server/test/*.test.ts",
    "agent:ui-test": "node --import tsx --test src/agent/api.test.ts src/agent/agentActionController.test.ts src/agent/agentInstallReadinessController.test.ts src/agent/agentPlayerActionReadinessController.test.ts src/agent/agentPlayerLabels.test.ts src/agent/agentProgressController.test.ts src/agent/agentRegionController.test.ts src/agent/AgentExplorer.layout.test.ts src/agent/localIdentity.test.ts src/agent/recoveryRotationController.test.ts src/agent/keyIsolation.test.ts scripts/copy-data.test.ts scripts/check-repository-import.test.ts scripts/check-strict-serial-validation.test.ts scripts/object-storage-manifest.test.ts",
    "batch:test": "node --import tsx --test ../chatgpt_creature_image_batch_core.test.ts"
  },
  "dependencies": {
    "@vitejs/plugin-react": "5.2.0",
    "3d-force-graph": "1.73.6",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "three": "0.184.0",
    "three-spritetext": "1.9.1",
    "vite": "7.3.5"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "three": "0.184.0"
  },
  "devDependencies": {
    "@types/node": "26.0.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.184.1",
    "tsx": "4.22.4",
    "typescript": "5.9.3"
  }
}
