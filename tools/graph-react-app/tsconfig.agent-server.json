{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "allowJs": false,
    "checkJs": false,
    "lib": ["DOM", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "noImplicitAny": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "types": ["node"]
  },
  "include": [
    "../agent-server/*.ts",
    "../agent-server/lib/**/*.ts",
    "../agent-server/package/**/*.ts",
    "scripts/*.ts"
  ],
  "exclude": [
    "../agent-server/test/**/*.ts",
    "../agent-server/**/*.test.ts",
    "../agent-server/**/*.test.tsx",
    "../agent-server/**/*.spec.ts",
    "../agent-server/**/*.spec.tsx",
    "scripts/**/*.test.ts",
    "scripts/**/*.test.tsx",
    "scripts/**/*.spec.ts",
    "scripts/**/*.spec.tsx"
  ]
}
